<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.thegoyalyogesh.qa</groupId>
        <artifactId>banking-automation-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>parabank-tests</artifactId>
    <packaging>jar</packaging>
    <name>ParaBank Tests</name>

    <properties>
        <!-- mvn test -DsuiteXmlFile=testng-unit.xml   |   mvn test -Dthreads=5 -Dbrowser=firefox -Dheadless=true -->
        <suiteXmlFile>testng-parabank.xml</suiteXmlFile>
        <threads>3</threads>
        <!-- the retry orchestrator sets this per run, e.g. "Run 2 - firefox" -->
        <report.title>ParaBank Automation</report.title>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.thegoyalyogesh.qa</groupId>
            <artifactId>automation-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-testng</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-picocontainer</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>extentreports</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                    </suiteXmlFiles>
                    <properties>
                        <property>
                            <name>dataproviderthreadcount</name>
                            <value>${threads}</value>
                        </property>
                    </properties>
                    <systemPropertyVariables>
                        <report.title>${report.title}</report.title>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- mvn -pl parabank-tests exec:java : run the suite with the retry engine (guide 10) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.github.thegoyalyogesh.qa.core.retry.RetryOrchestrator</mainClass>
                    <systemProperties>
                        <systemProperty>
                            <key>retry.moduleDir</key>
                            <value>${project.basedir}</value>
                        </systemProperty>
                        <systemProperty>
                            <key>retry.reportsDir</key>
                            <value>${project.basedir}/../reports</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
